            object-position: center top;
            border: 3px solid var(--accent);
            box-shadow: 0 0 25px var(--accent-glow);
            filter: grayscale(15%);
            transition: all 0.3s ease;
        }

        .avatar:hover {
            filter: grayscale(0%);
            transform: scale(1.02);
        }

