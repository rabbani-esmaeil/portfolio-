            color: var(--text-main);
        }

        .exp-org {
            color: var(--accent);
            font-size: 0.95rem;
            font-weight: 500;
        }

        .exp-date {
            font-size: 0.85rem;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.05);
            padding: 3px 10px;
            border-radius: 6px;
        }

        .exp-bullets {
            list-style: none;
            padding: 0;
            margin-top: 10px;
        }

        .exp-bullets li {
            position: relative;
            padding-right: 20px;
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 8px;
            line-height: 1.7;
            text-align: justify;
        }

