<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>وب‌سایت شخصی اسماعیل ربانی</title>
  
  <!-- اسکریپت ورود به پنل نتلایف -->
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  
  <style>
    /* تنظیمات پایه و اسکرول نرم */
    html { scroll-behavior: smooth; }
    body { 
      font-family: 'Vazir', 'B Nazanin', Tahoma, sans-serif; 
      background-color: #121212; 
      color: #e0e0e0; 
      margin: 0; 
      padding: 0; 
      line-height: 1.8; 
    }
    
    /* منوی بالای سایت (ثابت) */
    header { 
      background-color: #1e1e1e; 
      padding: 15px 30px; 
      position: sticky; 
      top: 0; 
      z-index: 1000; 
      box-shadow: 0 4px 10px rgba(0,0,0,0.5); 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      flex-wrap: wrap;
    }
    header h1 { margin: 0; font-size: 1.4rem; color: #fff; }
    header h1 span { font-size: 0.85rem; color: #aaa; font-weight: normal; }
    nav a { 
      color: #e0e0e0; 
      text-decoration: none; 
      margin: 0 10px; 
      font-weight: bold; 
      transition: color 0.3s; 
    }
    nav a:hover { color: #ff4081; }

    /* قالب‌بندی بخش‌ها */
    section { 
      padding: 80px 20px; 
      min-height: 60vh; 
      max-width: 900px; 
      margin: 0 auto; 
    }
    h2 { 
      border-bottom: 2px solid #ff4081; 
      padding-bottom: 10px; 
      margin-bottom: 30px; 
      color: #fff;
    }

    /* استایل پورتفولیو موسیقی */
    .music-list { display: flex; flex-direction: column; gap: 20px; }
    .music-item { 
      background-color: #1e1e1e; 
      padding: 20px; 
      border-radius: 12px; 
      box-shadow: 0 4px 8px rgba(0,0,0,0.3); 
    }
    .music-item h3 { margin-top: 0; color: #fff; }
    .music-item p { color: #aaa; font-size: 0.95rem; }
    audio { width: 100%; margin-top: 15px; outline: none; }

    /* فوتر و بخش تماس */
    .contact-info p { font-size: 1.1rem; }
    .contact-info a { color: #ff4081; text-decoration: none; }
    footer { 
      background-color: #1e1e1e; 
      text-align: center; 
      padding: 20px; 
      border-top: 1px solid #333; 
      font-size: 0.9rem;
    }
  </style>
</head>
<body>

  <!-- نوار منو -->
  <header>
    <h1>اسماعیل ربانی<br><span>مهندس و هنرمند</span></h1>
    <nav>
      <a href="#resume">سوابق حرفه‌ای</a>
      <a href="#extracurricular">موسیقی و هنر</a>
      <a href="#contact">تماس با من</a>
    </nav>
  </header>
<!-- بخش عکس پروفایل -->
  <div style="text-align: center; margin-top: 50px;">
    <!-- اگر اسم عکس شما avatar.png است، نام آن را در خط زیر تغییر دهید -->
    <img src="profile.jpg" alt="اسماعیل ربانی" style="width: 180px; height: 180px; border-radius: 50%; border: 3px solid #ff4081; object-fit: cover; box-shadow: 0 4px 15px rgba(0,0,0,0.5);">
  </div>
  <!-- بخش اول: رزومه -->
  <section id="resume">
    <h2>سوابق حرفه‌ای و اجرایی</h2>
    <p>
      متن رزومه و فعالیت‌های کاری شما در این قسمت قرار می‌گیرد. 
      می‌توانیم در مرحله بعدی، این بخش را هم به پنل ادمین متصل کنیم تا بتوانید سوابق جدید را بدون تغییر کد، مستقیماً از طریق پنل اضافه کنید.
    </p>
  </section>

  <!-- بخش دوم: پورتفولیو موسیقی -->
  <section id="extracurricular">
    <h2>موسیقی و علاقه‌مندی‌ها</h2>
    <div class="music-list">
      <!-- حلقه تکرار Eleventy برای نمایش موسیقی‌های آپلودی -->
      {% for item in collections.music %}
        <div class="music-item">
          <h3>{{ item.data.title }}</h3>
          <p>{{ item.data.description }}</p>
          <audio controls>
            <source src="{{ item.data.audio_file }}" type="audio/mpeg">
            مرورگر شما از پخش صدا پشتیبانی نمی‌کند.
          </audio>
        </div>
      {% else %}
        <p>هنوز قطعه موسیقی‌ای اضافه نشده است.</p>
      {% endfor %}
    </div>
  </section>

  <!-- بخش سوم: تماس با من -->
  <section id="contact">
    <h2>تماس با من</h2>
    <div class="contact-info">
      <p>برای ارتباط می‌توانید از طریق ایمیل زیر اقدام کنید:</p>
      <p>📧 ایمیل: <a href="mailto:rabbaniesmaeil@gmail.com">rabbaniesmaeil@gmail.com</a></p>
      <p>📞 موبایل: 09120882275 </p>
    </div>
  </section>

  <!-- فوتر -->
  <footer>
    <p>&copy; ۲۰۲۶ اسماعیل ربانی. تمامی حقوق محفوظ است.</p>
  </footer>

  <!-- فعال‌سازی ابزار شناسایی نتلایف -->
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.reload();
          });
        }
      });
    }
  </script>
</body>
</html>
